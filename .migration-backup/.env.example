# OCHP environment template
# Copy to .env for local tooling. Do not commit secrets.

# development | staging | production
OCHP_ENV=development

# Supabase project endpoint and public anon key used by the static frontend.
OHGL_SUPABASE_URL=https://PROJECT.supabase.co
OHGL_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Optional local static server port.
OCHP_LOCAL_PORT=8765

# Optional release metadata.
OCHP_RELEASE_VERSION=0.0.0
OCHP_RELEASE_COMMIT=local

# Optional integration placeholders. Keep provider secrets out of frontend config.
SHA_API_BASE_URL=
DHIS2_API_BASE_URL=
FHIR_BASE_URL=
NOTIFICATION_PROVIDER=
